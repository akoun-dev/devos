// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  posts            Post[]
  tasks            Task[]
  voicePreferences VoicePreferences[]
  projects         Project[]
  notes            Note[]
  aiConversations  AiConversation[]
  automations      Automation[]
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// ─── FEATURE-001 « Assistant vocal proactif » (contrat API v1 — .ai/API_CONTRACTS.md) ───

model Task {
  id                    String        @id @default(cuid())
  title                 String
  description           String?
  category              String        @default("general")
  priority              String        @default("normale")
  status                String        @default("en_cours")
  dueAt                 DateTime?
  reminderOffsetMinutes Int?
  reminderEnabled       Boolean       @default(true)
  projectId             String?
  project               Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderLogs          ReminderLog[]

  @@index([userId])
  @@index([projectId])
}

// ─── FEATURE-UI-SHELL « Espace de travail » (contrat API v1.3 — .ai/API_CONTRACTS.md) ───

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("actif")
  priority    String   @default("normale")
  favorite    Boolean  @default(false)
  color       String?
  dueAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  notes       Note[]

  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  favorite  Boolean  @default(false)
  trashed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
}

model VoicePreferences {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled               Boolean   @default(true)
  reminderOffsetMinutes Int       @default(60)
  announceNewTasks      Boolean   @default(true)
  announceDeadlines     Boolean   @default(true)
  announcePriorities    Boolean   @default(true)
  quietHoursEnabled     Boolean   @default(true)
  quietStart            String    @default("22:00")
  quietEnd              String    @default("07:00")
  quietDays             String    @default("0,1,2,3,4,5,6")
  style                 String    @default("naturel")
  language              String    @default("fr-FR")
  voice                 String?
  volume                Float     @default(1)
  allowedCategories     String    @default("")
  privacyMode           Boolean   @default(false)
  urgentOverrideQuiet   Boolean   @default(false)
  suspended             Boolean   @default(false)
  suspendedUntil        DateTime?
  updatedAt             DateTime  @updatedAt
}

model ReminderLog {
  id            String    @id @default(cuid())
  taskId        String?
  type          String
  scheduledFor  DateTime
  status        String    @default("annonce")
  firedAt       DateTime?
  snoozedUntil  DateTime?
  message       String?
  messageSource String?
  createdAt     DateTime  @default(now())
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, type, scheduledFor])
}

// ─── FEATURE-AI-HISTORY « Historique IA persistant » (contrat API v1.4 — .ai/API_CONTRACTS.md) ───

model AiConversation {
  id        String      @id @default(cuid())
  title     String      @default("Nouvelle conversation")
  context   String      @default("general")
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

// ─── FEATURE-AUTOMATIONS « Automatisations » (contrat API v1.4 — .ai/API_CONTRACTS.md) ───

model Automation {
  id            String          @id @default(cuid())
  name          String
  enabled       Boolean         @default(true)
  triggerType   String
  scheduleTime  String?
  scheduleDays  String          @default("1,2,3,4,5")
  conditionType String?
  threshold     Int?
  message       String?
  lastRunAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs          AutomationRun[]

  @@index([userId])
}

model AutomationRun {
  id            String     @id @default(cuid())
  automationId  String
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  userId        String
  trigger       String
  scheduledFor  DateTime
  status        String     @default("annonce")
  firedAt       DateTime?
  message       String?
  messageSource String?
  createdAt     DateTime   @default(now())

  @@unique([automationId, scheduledFor])
  @@index([userId, createdAt])
}
